# ZEVORA — Environment Configuration
# Copy this file to .env and fill in only the providers you use.
# NEVER commit .env to version control.
#
# ZEVORA can run the bundled local GGUF through llama.cpp or use cloud APIs.
# Local chat needs no API key or internet; cloud providers are optional fallbacks.

# ── Cloud AI Providers ────────────────────────────────────────────────────────
# Fill in at least one. ZEVORA will auto-detect which providers are configured.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Default provider when multiple are configured (openai, anthropic, deepseek, etc.)
CLOUD_DEFAULT_PROVIDER=openai

# ── Provider Discovery ────────────────────────────────────────────────────────
# How often to refresh the model registry (hours).
MODEL_REGISTRY_TTL_HOURS=24
PROVIDER_TIMEOUT_SECONDS=60

# ── Local intelligence runtime ─────────────────────────────────────────────────
LOCAL_MODEL_ENABLED=true
# llamacpp, ollama, or openai-compatible
LOCAL_MODEL_RUNTIME=llamacpp
LOCAL_ENDPOINT_URL=http://127.0.0.1:11434
LOCAL_ENDPOINT_API_KEY=
LOCAL_ENDPOINT_TIMEOUT_SECONDS=30
LOCAL_MODEL_PATH=models/zevora-4b-thinking.gguf
LOCAL_MODEL_PACKAGE_PATH=data/models/zevora-local
LOCAL_MODEL_EXTERNAL_PATH=
LOCAL_MODEL_REGISTRY_PATH=data/database/model_registry.db
LOCAL_MODEL_NAME=zevora
LOCAL_MODEL_CONTEXT_LENGTH=8192
LOCAL_MODEL_MAX_TOKENS=1024
LOCAL_MODEL_THREADS=0
LOCAL_MODEL_GPU_LAYERS=0
LOCAL_MODEL_TEMPERATURE=0.6

# ── Context economy ────────────────────────────────────────────────────────────
CONTEXT_MAX_TOKENS=12000
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_METRICS_ENABLED=true

# ── Skills and controlled evolution ────────────────────────────────────────────
SKILL_REGISTRY_PATH=data/database/skills.db
EVOLUTION_ENABLED=true
EVOLUTION_MIN_CONFIDENCE=0.80
EVOLUTION_REQUIRE_VERIFICATION=true

# ── Local Intelligence (Cache / Memory / Experience) ─────────────────────────
CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=false
MEMORY_ENABLED=true
EXPERIENCE_LOGGING=true
AUTO_BACKGROUND_TASKS=false
DATABASE_PATH=data/database/agent.db

# ── Basic skill source (optional read-only reference files) ──────────────────
BASIC_SKILLS_ENABLED=true
BASIC_SKILLS_DIR=E:\\SUPERAGENT-v3-OPENCLAW-HERMES\\openclaw\\skills
BASIC_SKILLS_ALLOWLIST=m0,m1,m2,m3,m4,m5,m6,m7,m8,m9,m11,m12,x1,x2,x3

# ── Storage budgets ───────────────────────────────────────────────────────────
MAX_TOTAL_STORAGE_GB=30
WARNING_STORAGE_GB=25
CRITICAL_STORAGE_GB=28
RAW_RETENTION_DAYS=30
CACHE_DEFAULT_TTL_HOURS=168
LOG_RETENTION_DAYS=14
DEBUG_LOG_RETENTION_DAYS=7
ARCHIVE_RETENTION_DAYS=365
MIN_MEMORY_SCORE=0.80
SEMANTIC_DUPLICATE_THRESHOLD=0.92
STORAGE_WARNING_PERCENT=75
STORAGE_CRITICAL_PERCENT=90
MAX_CACHE_GB=3
MAX_RAW_GB=5
MAX_LOG_GB=1
MAX_ARCHIVE_GB=10
MAX_EMBEDDING_GB=5

# ── Collective learning and verified updates ──────────────────────────────────
COLLECTIVE_LEARNING_ENABLED=false
COLLECTIVE_CONSENT_SKILLS=false
COLLECTIVE_CONSENT_KNOWLEDGE=false
COLLECTIVE_CONSENT_ROUTING=false
COLLECTIVE_CONSENT_EVALUATION=false
COLLECTIVE_REGISTRY_URL=
UPDATE_MANIFEST_URL=
UPDATE_CHANNEL=stable

# ── Routing ───────────────────────────────────────────────────────────────────
# AUTO        — local-first for light work, cloud-first for complex or vision work
# LOCAL_ONLY  — never call cloud providers
# CLOUD_ONLY  — never call the local model
ROUTING_MODE=AUTO
CLOUD_FALLBACK=true
COST_OPTIMIZATION=true
MAX_REPAIR_ATTEMPTS=1
ADAPTIVE_ROUTING=true
